# Application
APP_NAME="E-Commerce Admin Backend"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security (Generate a strong 64-char key in production)
SECRET_KEY=change-this-in-production-to-a-very-long-random-string-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Comma-separated URLs or wildcard *)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ecommerce_admin_db
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
MONGODB_MAX_IDLE_TIME_MS=45000

# Initial SuperAdmin Credentials (Seeded on first startup)
SUPERADMIN_EMAIL=superadmin@ecommerce.com
SUPERADMIN_PASSWORD=SuperAdmin@2026!
SUPERADMIN_FULL_NAME="Platform SuperAdmin"
